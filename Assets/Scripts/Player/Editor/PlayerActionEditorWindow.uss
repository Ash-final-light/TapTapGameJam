.player-editor { flex-grow: 1; }
.player-toolbar { flex-direction: row; flex-wrap: wrap; padding: 6px; border-bottom-width: 1px; border-bottom-color: #555555; }
.player-toolbar > * { margin-right: 6px; }
.player-object { min-width: 200px; flex-grow: 1; }
.player-object .unity-base-field__label { min-width: 32px; }
.player-body { flex-grow: 1; flex-direction: row; }
.player-library { width: 110px; flex-shrink: 0; border-right-width: 1px; border-right-color: #555555; padding: 6px; }
.player-library Button { margin-bottom: 4px; }
.player-library .selected { background-color: #355777; color: #ffffff; }
.player-center { flex-grow: 1; min-width: 300px; }
.player-preview { height: 230px; }
.player-timeline { padding: 6px; }
.player-inspector { width: 270px; flex-shrink: 0; border-left-width: 1px; border-left-color: #555555; padding: 6px; }
.player-debug { padding: 6px; border-top-width: 1px; border-top-color: #555555; }
.player-status { white-space: normal; padding: 4px; }
